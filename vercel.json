{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rootDirectory": ".",
  "buildCommand": "npm --prefix backend run build",
  "outputDirectory": "backend/dist",
  "installCommand": "npm --prefix backend install",
  "devCommand": "npm --prefix backend run dev:server",
  "functions": {
    "backend/api/index.ts": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    }
  ]
}