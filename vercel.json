{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix backend",
  "outputDirectory": "backend/dist",
  "framework": "node",
  "installCommand": "npm install --include=dev --prefix backend",
  "devCommand": "npm run dev:server --prefix backend",
  "functions": {
    "backend/api/index.ts": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    }
  ]
}