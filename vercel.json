{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd backend && npm run build",
  "outputDirectory": "backend/dist",
  "framework": "node",
  "installCommand": "cd backend && npm install --include=dev",
  "devCommand": "cd backend && npm run dev:server",
  "functions": {
    "backend/api/index.ts": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/index.ts"
    }
  ]
}