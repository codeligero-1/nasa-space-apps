{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "node",
  "installCommand": "npm install",
  "devCommand": "npm run dev:server",
  "functions": {
    "src/api/index.ts": {
      "maxDuration": 30,
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/src/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/src/api/index.ts"
    }
  ]
}