# Exclude server build output from Vercel deployment
# This prevents dist/index.js (or dist/main.js) from being detected as entrypoint
dist/
node_modules/
*.log
.env
.env.local
.env.production.local

# Exclude development files
src/
tsconfig.json
package.json
package-lock.json
.git/
.gitignore
README.md

# Keep only what's needed for API function
!backend/api/