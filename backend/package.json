{
  "name": "nasa-spaceapps-backend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/combined.ts",
    "type-check": "npx tsc --noEmit",
    "db:init": "tsx src/db/init.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test:db": "tsx src/test-db.ts",
    "test:supabase": "tsx src/test-supabase.ts",
    "push:supabase": "tsx src/supabase-push.ts",
    "build": "node node_modules/typescript/bin/tsc --noEmit false --outDir dist",
    "start": "node dist/index.js",
    "start:server": "node dist/combined.js",
    "test:admin": "tsx --test src/admin-auth.test.ts src/server.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^18.0.10",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "@vercel/node": "^31.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
